# Site body for the isolated native NB demo (LT-575).
# Usage inside the site block:  import /etc/caddy/nb-demo.caddy <loopback-port>
# Mirrors the browser isolation proven in staging: only same-origin assets and API.
header {
	Strict-Transport-Security "max-age=300"
	X-Content-Type-Options "nosniff"
	Referrer-Policy "no-referrer"
	X-Frame-Options "DENY"
	Permissions-Policy "camera=(), microphone=(), geolocation=()"
	Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self'; media-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
	-Server
	-X-Powered-By
}

request_body {
	max_size 1MB
}

# Closed in the demo: open registration and the password-reset chain (an unauthenticated
# user lookup returns reset identifiers), unrestricted user listing, admin and class email,
# upstream NB1 redirects to MIT hosts, and socket.io (its room join is unauthenticated and
# broadcasts thread content regardless of visibility). Synthetic accounts are created on loopback only.
# Every path is a prefix match: native Express routes also answer with a trailing slash.
@nb_demo_closed path /api/users/register* /api/users/forgotpassword* /api/users/getuser* /api/users/user/* /api/users/all* /api/admin* /api/email* /embed_NB.js* /c/* /f/* /pdf4/rpc* /content/* /settings* /socket.io*
respond @nb_demo_closed 404

reverse_proxy 127.0.0.1:{args[0]}
